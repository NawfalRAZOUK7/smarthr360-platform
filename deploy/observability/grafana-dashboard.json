{
  "title": "SmartHR360 Platform",
  "uid": "smarthr360-platform",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "prometheus" },
        "query": "label_values(django_http_requests_total_by_method_total, service)",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by service (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (service) (rate(django_http_requests_total_by_method_total{service=~\"$service\"}[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 latency by service (s)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(django_http_requests_latency_seconds_by_view_method_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "5xx responses by service (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (service) (rate(django_http_responses_total_by_status_total{status=~\"5..\",service=~\"$service\"}[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "4xx responses by service (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (service) (rate(django_http_responses_total_by_status_total{status=~\"4..\",service=~\"$service\"}[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "In-flight requests",
      "type": "stat",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 6 },
      "targets": [
        { "expr": "sum(django_http_requests_latency_including_middlewares_seconds_count{service=~\"$service\"})" }
      ]
    },
    {
      "id": 6,
      "title": "Up targets",
      "type": "stat",
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 6 },
      "targets": [
        { "expr": "count(up{job=\"smarthr360\"} == 1)" }
      ]
    }
  ]
}
