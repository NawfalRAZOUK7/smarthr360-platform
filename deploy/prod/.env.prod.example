# Copy to deploy/prod/.env.prod and fill in. NEVER commit the real file.
#
# Generate every secret below with:
#   ./scripts/gen_secret.sh
#
# Or fill them all in one go:
#   for v in AUTH CORE_HR CAREER_SIM FUTURE_SKILLS WORKLOAD POLICY_GEN RETENTION; do
#     echo "${v}_SECRET_KEY=$(./scripts/gen_secret.sh)"
#   done >> deploy/prod/.env.prod
#   echo "POSTGRES_PASSWORD=$(./scripts/gen_secret.sh 32)" >> deploy/prod/.env.prod

# Public domain (DNS A-record must point at the VM). Caddy gets HTTPS automatically.
DEMO_DOMAIN=demo.smarthr360.example.com

# --- Django ---
DEBUG=False
ALLOWED_HOSTS=demo.smarthr360.example.com
CSRF_TRUSTED_ORIGINS=https://demo.smarthr360.example.com
CORS_ALLOWED_ORIGINS=https://demo.smarthr360.example.com

# --- Per-service signing keys ---
# Each service gets its own key: one leaked key must not let an attacker forge
# sessions for the whole platform. Compose refuses to start without all seven.
AUTH_SECRET_KEY=change-me-run-scripts-gen_secret.sh
CORE_HR_SECRET_KEY=change-me-run-scripts-gen_secret.sh
CAREER_SIM_SECRET_KEY=change-me-run-scripts-gen_secret.sh
FUTURE_SKILLS_SECRET_KEY=change-me-run-scripts-gen_secret.sh
WORKLOAD_SECRET_KEY=change-me-run-scripts-gen_secret.sh
POLICY_GEN_SECRET_KEY=change-me-run-scripts-gen_secret.sh
RETENTION_SECRET_KEY=change-me-run-scripts-gen_secret.sh

# --- Database (each service uses its own DB name on the shared postgres) ---
POSTGRES_USER=smarthr
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Images ---
# The seven Django services are pulled from GHCR rather than built on the VM.
# Defaults to the images published from main; pin a tag to deploy a release.
IMAGE_TAG=main

# --- Observability (optional; the stack runs without these) ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# --- JWT (RS256 keypair generated by scripts/generate_rsa_keys.sh) ---
# deploy.sh runs that script if keys/ is empty. On Linux the private key is
# written 0600 owned by the deploying user, while the services run as uid 10001
# and read it through a compose secret bind-mount -- if auth fails to start with
# PermissionError on /run/secrets/jwt_private.pem, that ownership is why.

# --- Public demo hardening ---
# Heavy ML recalculation runs async on the public box.
FUTURE_SKILLS_ASYNC_PREDICT=1
